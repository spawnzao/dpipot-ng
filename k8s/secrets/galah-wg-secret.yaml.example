apiVersion: v1
kind: Secret
metadata:
  name: galah-wg-secret
  namespace: dpipot
type: Opaque
stringData:
  # The filename matters: it becomes "wg-llm" as the interface name when
  # the initContainer runs `wg-quick up /etc/wireguard-secret/wg-llm.conf`.
  # Only used when honeypots.galah.wgTunnel.enabled=true (standalone honeypot
  # host, no local dpipot-proxy) — galah brings up this tunnel inside the
  # pod to talk only to the LLM backend, isolated from the rest of the
  # honeypot network.
  wg-llm.conf: |
    [Interface]
    PrivateKey = <GALAH_PRIVATE_KEY>
    Address = 10.99.99.3/24

    [Peer]
    PublicKey = <LLM_HOST_PUBLIC_KEY>
    PresharedKey = <PRESHARED_KEY>
    AllowedIPs = 10.99.99.0/24
    PersistentKeepalive = 25
    Endpoint = <LLM_HOST_PUBLIC_IP>:51820
