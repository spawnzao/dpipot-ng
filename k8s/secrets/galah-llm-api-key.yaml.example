apiVersion: v1
kind: Secret
metadata:
  name: galah-llm-api-key
  namespace: dpipot
type: Opaque
stringData:
  # API key for the LLM provider configured in honeypots.galah.llmApiBase
  # (k8s/chart-standalone/values.yaml) — used only by the standalone chart.
  api_key: "gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
